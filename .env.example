# Wazuh MCP Server Configuration
# Production-ready MCP-compliant server for Wazuh SIEM integration
# Copy to .env and update with your settings

# === Wazuh Configuration ===
WAZUH_HOST=https://your-wazuh-server.com
WAZUH_USER=your-api-user
WAZUH_PASS=your-api-password
WAZUH_PORT=55000

# === MCP Server Configuration ===
# Host to bind to (use 127.0.0.1 for local only, 0.0.0.0 for all interfaces)
MCP_HOST=127.0.0.1
MCP_PORT=3000

# === Authentication ===
# Auth mode: bearer (default), oauth, or none (authless)
AUTH_MODE=bearer

# When AUTH_MODE=none (authless), active response/write tools are disabled by default.
# Set to true to explicitly allow write operations without authentication.
# AUTHLESS_ALLOW_WRITE=false

# SECURITY: Generate a secure secret key for production!
# Run: openssl rand -hex 32
AUTH_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Token lifetime in hours
TOKEN_LIFETIME_HOURS=24

# === API Key Configuration (Recommended for production) ===
# Simple single API key configuration - generate with:
#   python -c "import secrets; print('wazuh_' + secrets.token_urlsafe(32))"
# If not set, server auto-generates a key and displays it on startup
# For compose.full.yml, set this so Open WebUI can auto-register the MCP server
# without manual copy/paste from container logs.
# Generate: python3 -c "import secrets; print('wazuh_' + secrets.token_urlsafe(32))"
MCP_API_KEY=CHANGE_ME
# MCP Security Proxy client bearer (defaults differ if unset). For Profile C, set equal to MCP_API_KEY:
# MCP_PROXY_API_KEY=${MCP_API_KEY}
# Phase A4: bash tools/apply_mcp_proxy_phase_a4.sh

# Advanced: Multiple API keys (JSON array format)
# Only use if you need multiple keys with different scopes
# API_KEYS=[{"id":"key1","name":"Production","key_hash":"...","scopes":["wazuh:read"]}]

# === CORS Configuration ===
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://claude.ai,https://*.anthropic.com,http://localhost:*

# === SSL Configuration (Optional) ===
# For HTTPS support
# SSL_KEYFILE=/path/to/privkey.pem
# SSL_CERTFILE=/path/to/fullchain.pem

# === Logging ===
LOG_LEVEL=INFO

# === Timezone Alignment (Frontend + Backend) ===
# Keep all containers on the same timezone to avoid "last 1h" confusion between
# Wazuh Dashboard/Open WebUI (frontend) and MCP/Wazuh services (backend).
# Recommended: UTC. Example local override: Europe/Berlin, America/New_York.
TZ=UTC

# === Docker Model Runner (compose.full.yml only) ===
# Smaller defaults keep memory usage lower for local demos.
# Examples:
#   MODEL_RUNNER_MODEL=ai/qwen2.5:1.5b
#   MODEL_RUNNER_MODEL=ai/qwen2.5:3b
# Presets:
#   Ultra-low-RAM  -> ai/qwen2.5:1.5b
#   Balanced       -> ai/qwen2.5:3b
#   Higher quality -> ai/gemma3-qat:latest or ai/qwen3:latest
#   Highest quality -> ai/qwen3:14B-Q6_KV:latest (requires more resources, test with qwen3:latest first)
MODEL_RUNNER_MODEL=ai/qwen3

# === Phase 2 LangChain synthesis (optional) ===
# Enables analyst-facing summaries for Phase 2 tools via a local OpenAI-compatible endpoint.
# Pattern 1 default: route Phase 2 through local AgentGuard reverse proxy.
PHASE2_LLM_ENABLED=false
PHASE2_LLM_MODEL=ai/qwen3
PHASE2_LLM_BASE_URL=http://agentguard:8088/v1/proxy/openai/v1
PHASE2_LLM_API_KEY=not-needed
PHASE2_LLM_TIMEOUT_SECONDS=45

# AgentGuard local upstream (Docker Model Runner)
AGENTGUARD_OPENAI_UPSTREAM=http://model-runner.docker.internal/engines

# Synthetic Apache traffic generation interval (seconds) used by compose.full.yml
# for demo/test alert generation. Lower values create more events.
APACHE_LOG_GENERATOR_INTERVAL_SECONDS=5

# === Wazuh SSL ===
# SECURITY: Set WAZUH_VERIFY_SSL=true in production!
# Only set to false for development with self-signed certificates
WAZUH_VERIFY_SSL=true
# WAZUH_ALLOW_SELF_SIGNED=true  # Uncomment only for dev/testing

# === Wazuh Indexer Configuration (Required for Wazuh 4.8.0+) ===
# The vulnerability API was removed in Wazuh 4.8.0 and replaced with Indexer queries.
# Configure these settings to enable vulnerability tools.
# WAZUH_INDEXER_HOST=your-wazuh-indexer.com
# WAZUH_INDEXER_PORT=9200
# WAZUH_INDEXER_USER=admin
# WAZUH_INDEXER_PASS=admin

# === Session Storage (Serverless Ready) ===
# Optional Redis URL for serverless/multi-instance deployments
# If not set, uses in-memory storage (single-instance only)
# REDIS_URL=redis://localhost:6379/0
# SESSION_TTL_SECONDS=1800

# === OSS Langfuse tracing (optional, Phase 3) ===
# For local/self-hosted tracing using compose.langfuse.oss.yml
# LANGFUSE_ENABLED=false
# LANGFUSE_HOST=http://langfuse-web:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_TRACE_NAME=phase3_workflow
# LANGFUSE_PORT=3001
# LANGFUSE_PUBLIC_URL=http://localhost:3001
# LANGFUSE_NEXTAUTH_SECRET=change_me_langfuse_nextauth_secret
# LANGFUSE_SALT=change_me_langfuse_salt
# LANGFUSE_POSTGRES_DB=langfuse
# LANGFUSE_POSTGRES_USER=langfuse
# LANGFUSE_POSTGRES_PASSWORD=langfuse
# LANGFUSE_MINIO_ROOT_USER=minio

# === OpenCTI Threat Intelligence Platform (compose.opencti.yml) ===
# UI: http://localhost:8083
# Login: OPENCTI_ADMIN_EMAIL / OPENCTI_ADMIN_PASSWORD
# The token below is passed to phase4-api so it can push bundles to OpenCTI.
# Generate a fresh one with: python3 -c "import uuid; print(uuid.uuid4())"
OPENCTI_ADMIN_EMAIL=admin@opencti.local
OPENCTI_ADMIN_PASSWORD=OpenCTI_Admin_Change_Me!
OPENCTI_ADMIN_TOKEN=a1b2c3d4-e5f6-7890-abcd-ef1234567890
OPENCTI_BASE_URL=http://localhost:8083
# Internal service URL used by phase4-api inside Docker network:
OPENCTI_URL=http://opencti-platform:4000
# Stable UUID for the STIX2 file-import connector (keep as-is unless you run multiple stacks):
OPENCTI_CONNECTOR_IMPORT_STIX2_ID=11111111-2222-3333-4444-555555555555
# LANGFUSE_MINIO_ROOT_PASSWORD=minio123
# LANGFUSE_INIT_ORG_ID=local-org
# LANGFUSE_INIT_ORG_NAME=Local Org
# LANGFUSE_INIT_PROJECT_ID=local-project
# LANGFUSE_INIT_PROJECT_NAME=local-project
# LANGFUSE_INIT_USER_EMAIL=local-admin@example.com
# LANGFUSE_INIT_USER_NAME=Local Admin
# LANGFUSE_INIT_USER_PASSWORD=local-admin-password
# LANGFUSE_CLICKHOUSE_USER=default
# LANGFUSE_CLICKHOUSE_PASSWORD=langfuse
# LANGFUSE_CLICKHOUSE_DB=default
# LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
# LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
# LANGFUSE_TELEMETRY_ENABLED=false