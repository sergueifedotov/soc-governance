# Upstream MCP server this proxy forwards allowed calls to.
MCP_PROXY_UPSTREAM_URL=http://host.docker.internal:3000/mcp
MCP_PROXY_UPSTREAM_API_KEY=

# Bearer token clients must present to the proxy. Change before any non-local use.
MCP_PROXY_API_KEY=mcp_proxy_local_demo_change_me

MCP_PROXY_FORWARD_TIMEOUT_SECONDS=30
MCP_PROXY_LOG_LEVEL=INFO
MCP_PROXY_POLICY_FILE=config/policy.json

# Optional LLM risk scoring (leave empty to disable / use policy.json defaults).
MCP_PROXY_LLM_API_KEY=

# Runtime state (created on start).
MCP_PROXY_HISTORY_FILE=data/runtime_history.json
MCP_PROXY_USAGE_COUNTERS_FILE=data/usage_counters.json
MCP_PROXY_GOVERNANCE_DATA_DIR=data/governance
