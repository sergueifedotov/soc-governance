AGENTGUARD_HOST=0.0.0.0
AGENTGUARD_PORT=8088
AGENTGUARD_LOG_LEVEL=INFO
AGENTGUARD_POLICY_FILE=./policy.yaml
# Upstream for /v1/proxy/openai/* — AgentGuard appends "/v1/chat/completions".
# Cloud OpenAI:                  https://api.openai.com
# Local LLM via Docker Model Runner (Wazuh stack):  http://model-runner.docker.internal/engines
# Local LLM via Ollama:          http://host.docker.internal:11434
AGENTGUARD_OPENAI_UPSTREAM=https://api.openai.com
AGENTGUARD_ANTHROPIC_UPSTREAM=https://api.anthropic.com
AGENTGUARD_ML_CLASSIFIER_URL=
AGENTGUARD_AUDIT_BUFFER_SIZE=1000
