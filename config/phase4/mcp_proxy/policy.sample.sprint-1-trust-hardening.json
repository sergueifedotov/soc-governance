{
  "allowed_methods": [
    "initialize",
    "notifications/initialized",
    "ping",
    "tools/list",
    "tools/call"
  ],
  "denied_tools": [
    "wazuh_block_ip",
    "wazuh_isolate_host",
    "wazuh_kill_process",
    "wazuh_disable_user",
    "wazuh_quarantine_file",
    "wazuh_active_response",
    "wazuh_firewall_drop",
    "wazuh_host_deny",
    "wazuh_restart",
    "wazuh_unisolate_host",
    "wazuh_enable_user",
    "wazuh_restore_file",
    "wazuh_firewall_allow",
    "wazuh_host_allow"
  ],
  "blocked_argument_patterns": [
    "(?i)\\b(ignore\\s+previous\\s+instructions|system\\s+prompt|tool\\s+override)\\b",
    "(?i)\\b(drop\\s+table|union\\s+select|insert\\s+into|;\\s*shutdown)\\b",
    "(?i)(\\.\\./|%2e%2e|\\$\\(|`[^`]+`)",
    "(?i)\\b(curl|wget|nc|bash\\s+-c|powershell)\\b"
  ],
  "blocked_pattern_action": "challenge",
  "llm_risk": {
    "enabled": true,
    "provider": "langchain",
    "model": "ai/gemma3-qat:latest",
    "base_url": "http://model-runner.docker.internal/engines/v1",
    "api_key": "local-demo",
    "timeout_seconds": 5,
    "min_monitor_score": 0.55,
    "min_challenge_score": 0.65,
    "min_deny_score": 0.69,
    "enforce": true,
    "max_argument_chars": 2000,
    "system_prompt": "You are an MCP security risk classifier. Return only compact JSON with keys: decision_hint, risk_score, labels, rationale. decision_hint must be one of allow, monitor, challenge, deny. risk_score must be 0..1. Never return allow when arguments indicate abuse, exfiltration, credential theft, fraud staging, covert mining/resource hijacking, privilege escalation, defense evasion, persistence, supply-chain tampering, ransomware, destructive wipe, or unauthorized key/role manipulation. For such content, return at least challenge."
  },
  "tool_intent": {
    "enabled": true,
    "provider": "langchain",
    "model": "ai/gemma3-qat:latest",
    "base_url": "http://model-runner.docker.internal/engines/v1",
    "api_key": "local-demo",
    "timeout_seconds": 5,
    "min_monitor_score": 0.2,
    "min_challenge_score": 0.3,
    "min_deny_score": 0.6,
    "enforce": true,
    "max_argument_chars": 2000,
    "require_intent_metadata": true,
    "metadata_intent_keys": [
      "intent",
      "declared_intent",
      "task_intent"
    ],
    "system_prompt": "You are an MCP tool-intent verifier. Compare declared intent against selected method/tool/arguments. Return only compact JSON with keys: decision_hint, intent_score, labels, rationale. decision_hint must be one of allow, monitor, challenge, deny. intent_score must be 0..1 where higher means stronger intent mismatch risk. If arguments include abuse objectives (exfiltration, credential/password/token theft, MFA bypass/account takeover, privilege escalation, defense evasion, forensic/log tampering, hidden persistence, supply-chain backdoor activity, ransomware/destructive wipe, fraud staging, or resource hijacking/mining concealment), you must return challenge or deny and never allow."
  },
  "max_body_bytes": 262144,
  "tool_name_regex": "^[a-zA-Z0-9_:-]{1,120}$",
  "masking_rules": [],
  "discovery_rules": [
    {
      "signal": "untrusted_server_calls",
      "action_on_trigger": "monitor"
    },
    {
      "signal": "descriptor_drift_events",
      "action_on_trigger": "monitor"
    },
    {
      "signal": "execution_tool_attempts",
      "action_on_trigger": "monitor"
    }
  ],
  "trusted_servers": [
    "http://wazuh-mcp-server:3000/mcp",
    "http://wazuh-mcp-server:3000",
    "wazuh-mcp-server:3000",
    "http://host.docker.internal:3000/mcp",
    "http://localhost:3000/mcp"
  ],
  "untrusted_server_action": "deny",
  "tool_descriptor_hashes": {},
  "descriptor_drift_action": "deny",
  "execution_tool_profile": {
    "enabled": true,
    "action": "deny",
    "patterns": [
      "exec",
      "shell",
      "run_command",
      "eval",
      "subprocess",
      "python_repl",
      "bash",
      "powershell",
      "ssh"
    ]
  },
  "sandbox_attestation_profile": {
    "enabled": false,
    "action": "deny"
  },
  "dependency_fail_safe_profile": {
    "enabled": false,
    "action": "deny",
    "prevent_silent_bypass": false
  },
  "isolated_executor_profile": {
    "enabled": false,
    "action": "deny",
    "executor_url": "",
    "fallback_to_upstream": false
  },
  "upstream_provenance_profile": {
    "enabled": false,
    "action": "deny"
  }
}
